 from .models import CLIP, VAE, BaseModel, UNet, VAEEncoder
 
 
-TRT_LOGGER = trt.Logger(trt.Logger.ERROR)
+TRT_LOGGER = trt.Logger(trt.Logger.VERBOSE)
 
 # Map of numpy dtype -> torch dtype
